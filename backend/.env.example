# Copy to backend/.env and adjust. Never commit the real .env.

HOST=0.0.0.0
PORT=8000

# Ollama — local LLM and embeddings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GEN_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Models used by "Jury" mode (comma-separated, must be pulled in Ollama)
JURY_MODELS=qwen2.5:7b,llama3.1:8b

# Answer questions the documents can't, from general knowledge (always labelled as such)
ALLOW_GENERAL_KNOWLEDGE=true

# Voice questions (faster-whisper size) and OCR languages (tesseract)
WHISPER_MODEL=base
OCR_LANGUAGES=eng+hin+mar

# Telegram bot — leave empty to disable. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed to upload documents (comma-separated; send /myid to the bot)
TELEGRAM_ADMIN_IDS=
