{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/ask.py": { "maxDuration": 300 },
    "api/audit.py": { "maxDuration": 300 },
    "api/insights.py": { "maxDuration": 300 },
    "api/timeline.py": { "maxDuration": 300 },
    "api/health.py": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
